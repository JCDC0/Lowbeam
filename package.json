{
  "name": "lowbeam",
  "version": "0.9.84",
  "private": true,
  "description": "A PS1-style night driving game: cars, an expressway, a city, a mountain pass and a forest at night.",
  "type": "module",
  "scripts": {
    "start": "node tools/devserver.mjs 8040",
    "check": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "sim": "node tools/sim.mjs",
    "bench": "node tools/buildbench.mjs",
    "music": "node tools/music-manifest.mjs"
  },
  "devDependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/m-plus-1p": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "dseg": "^0.46.0",
    "three": "0.185.1",
    "typescript": "^5.7.2"
  },
  "//": "No build step. Three.js is vendored in vendor/ and loaded through the import map in index.html. The npm copy exists for tsc types only."
}
